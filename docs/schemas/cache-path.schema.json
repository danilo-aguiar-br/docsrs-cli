{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docsrs-cli cache path/clear/stats success data",
  "oneOf": [
    {
      "title": "cache-path",
      "type": "object",
      "required": [
        "source",
        "no_cache"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "cli",
            "xdg",
            "unresolved"
          ]
        },
        "no_cache": {
          "type": "boolean"
        }
      }
    },
    {
      "title": "cache-clear",
      "type": "object",
      "required": [
        "root",
        "removed_entries",
        "freed_bytes",
        "target_source"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "removed_entries": {
          "type": "integer",
          "minimum": 0
        },
        "freed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "target_source": {
          "type": "string",
          "enum": [
            "cli",
            "xdg",
            "unresolved"
          ],
          "description": "Which layer designated the deleted root. `cli` means --cache-dir named it in argv; `xdg` means the caller waived designation with --yes and accepted the ambient root."
        }
      }
    },
    {
      "title": "cache-stats",
      "type": "object",
      "required": [
        "root",
        "layout",
        "entries",
        "total_bytes",
        "max_bytes",
        "ttl_secs",
        "parser_version"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "layout": {
          "type": "string"
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "0 means unlimited"
        },
        "ttl_secs": {
          "type": "integer",
          "minimum": 0
        },
        "parser_version": {
          "type": "string"
        }
      }
    }
  ]
}
