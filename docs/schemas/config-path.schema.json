{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docsrs-cli config command success data",
  "description": "Payload under envelope.data for config path|show|init. Outer envelope always has schema_version=1, ok, command, duration_ms. command is config-path, config-show, or config-init. Product knobs come from flags and XDG TOML only.",
  "oneOf": [
    {
      "title": "config-path",
      "type": "object",
      "required": [
        "config_source",
        "config_file_exists",
        "config_toml_loaded",
        "cache_source",
        "dotenv_runtime",
        "secrets_layers"
      ],
      "additionalProperties": false,
      "properties": {
        "config_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_source": {
          "type": "string",
          "enum": [
            "cli", "xdg", "unresolved"
          ]
        },
        "config_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_file_exists": {
          "type": "boolean"
        },
        "config_toml_loaded": {
          "type": "boolean"
        },
        "cache_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_source": {
          "type": "string",
          "enum": [
            "cli", "xdg", "unresolved"
          ]
        },
        "dotenv_runtime": {
          "type": "boolean",
          "const": false
        },
        "secrets_layers": {
          "type": "string"
        }
      }
    },
    {
      "title": "config-show",
      "type": "object",
      "description": "Effective Config after defaults + TOML + CLI. Product has no secret fields. Paths resolve via --config-dir/--cache-dir or XDG only (no product env).",
      "required": [
        "timeout_secs",
        "config_path_source",
        "cache_path_source",
        "config_toml_loaded"
      ],
      "additionalProperties": false,
      "properties": {
        "timeout_secs": {
          "type": "integer"
        },
        "connect_timeout_secs": {
          "type": "integer"
        },
        "max_body_bytes": {
          "type": "integer"
        },
        "max_output_bytes": {
          "type": "integer"
        },
        "max_redirects": {
          "type": "integer"
        },
        "max_retries": {
          "type": "integer"
        },
        "retry_base_ms": {
          "type": "integer"
        },
        "retry_max_delay_ms": {
          "type": "integer"
        },
        "disable_retry": {
          "type": "boolean"
        },
        "rate_limit_delay_ms": {
          "type": "integer"
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 0
        },
        "user_agent": {
          "type": "string"
        },
        "contact": {
          "type": [
            "string",
            "null"
          ]
        },
        "lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_ttl_secs": {
          "type": "integer"
        },
        "max_cache_bytes": {
          "type": "integer"
        },
        "no_cache": {
          "type": "boolean"
        },
        "crates_io_origin": {
          "type": "string"
        },
        "docs_rs_origin": {
          "type": "string"
        },
        "allow_loopback": {
          "type": "boolean",
          "description": "When true, SSRF allowlist accepts 127.0.0.1/localhost (offline wiremock). CLI --allow-loopback or XDG TOML only; never env."
        },
        "config_path_source": {
          "type": "string",
          "enum": [
            "cli", "xdg", "unresolved"
          ]
        },
        "cache_path_source": {
          "type": "string",
          "enum": [
            "cli", "xdg", "unresolved"
          ]
        },
        "config_toml_loaded": {
          "type": "boolean"
        }
      }
    },
    {
      "title": "config-init",
      "type": "object",
      "required": [
        "path",
        "config_dir",
        "source",
        "created",
        "overwritten"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "config_dir": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "cli", "xdg", "unresolved"
          ]
        },
        "created": {
          "type": "boolean"
        },
        "overwritten": {
          "type": "boolean"
        }
      }
    }
  ]
}
