{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docsrs-cli search-crates success data",
  "type": "object",
  "description": "Payload under envelope.data for command search-crates. Outer envelope always has schema_version=1, ok, command, duration_ms. Optional hit/meta fields are omitted when absent (skip_serializing_if / not serialized as null).",
  "required": [
    "query",
    "page",
    "per_page",
    "sort",
    "hits",
    "meta",
    "cache_hit"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "per_page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "sort": {
      "type": "string",
      "enum": [
        "relevance",
        "downloads",
        "recent-downloads",
        "recent-updates",
        "new",
        "alphabetical"
      ]
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "downloads",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "downloads": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "string"
          },
          "documentation": {
            "type": "string",
            "description": "Omitted when absent (never JSON null)"
          },
          "max_version": {
            "type": "string",
            "description": "Omitted when absent (never JSON null)"
          },
          "max_stable_version": {
            "type": "string",
            "description": "Omitted when absent (never JSON null)"
          },
          "default_version": {
            "type": "string",
            "description": "Omitted when absent (never JSON null)"
          },
          "recent_downloads": {
            "type": "integer",
            "minimum": 0,
            "description": "Omitted when absent (never JSON null)"
          },
          "exact_match": {
            "type": "boolean",
            "description": "Omitted when absent (never JSON null)"
          },
          "yanked": {
            "type": "boolean",
            "description": "Omitted when absent (never JSON null)"
          },
          "repository": {
            "type": "string",
            "description": "Omitted when absent (never JSON null)"
          },
          "homepage": {
            "type": "string",
            "description": "Omitted when absent (never JSON null)"
          }
        },
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "total"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "next_page": {
          "type": "string",
          "description": "Omitted when absent (never JSON null)"
        },
        "prev_page": {
          "type": "string",
          "description": "Omitted when absent (never JSON null)"
        }
      },
      "additionalProperties": false
    },
    "cache_hit": {
      "type": "boolean",
      "description": "True when the HTTP response body was served from the local disk cache"
    }
  },
  "additionalProperties": false
}
